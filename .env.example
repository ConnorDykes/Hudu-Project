# No secrets are required for local development. Scripts do not source .env.
# Set API_BASE_URL in your shell before running scripts/dev.sh or dev.ps1.
# bash: export API_BASE_URL=http://127.0.0.1:3000
# PowerShell: $env:API_BASE_URL = 'http://127.0.0.1:3000'
# The scripts pass this to Flutter as a compile-time --dart-define.
API_BASE_URL=http://127.0.0.1:3000
# Compose always runs Rails in development and publishes on loopback only.
